# Environment file for run8map.service. Install as /opt/run8map/run8map.env and
# lock it down:  sudo chown root:run8map /opt/run8map/run8map.env
#                sudo chmod 640 /opt/run8map/run8map.env
#
# Generate a strong token (put the SAME value in the Windows agent.ini):
#   openssl rand -hex 32
UPLOAD_TOKEN=replace-with-a-long-random-secret
