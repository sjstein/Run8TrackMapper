# Environment file for run8map.service. Install as /opt/run8map/run8map.env and
# lock it down:  sudo chown root:run8map /opt/run8map/run8map.env
#                sudo chmod 640 /opt/run8map/run8map.env
#
# Generate a strong token (put the SAME value in the Windows agent.ini):
#   openssl rand -hex 32
# serve.py reads this from the environment (see run8map.service).
RUN8_UPLOAD_TOKEN=replace-with-a-long-random-secret

# Optional: shared password that unlocks LABEL EDITING (#56). Leave it unset/commented
# to keep the map read-only (the default). When set, staff type "edit" in the viewer and
# unlock with this password to add/edit labels. The droplet is behind Caddy (https), so
# the password is encrypted in transit. Rotate by changing this and restarting the service.
#RUN8_EDIT_PASSWORD=replace-with-a-long-shared-passphrase
